# PostgreSQL + Apache AGE
DATABASE_URL=postgresql://openclaw:openclaw@localhost:5433/openclaw_memory

# Redis 8.4
REDIS_URL=redis://localhost:6380/0

# Embedding model (sentence-transformers)
# bge-base-en-v1.5: 768-dim, MTEB ~63, best quality/speed for CPU
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Embedding cache TTL in seconds (24 hours)
EMBEDDING_CACHE_TTL=86400

# MCP server (SSE/HTTP transport)
MCP_HOST=0.0.0.0
MCP_PORT=8081

# MCP HTTP/SSE Bearer auth (stdio is never authenticated)
# Generate with: mem token create
# AGENTMEMORY_AUTH_REQUIRED=true
# AGENTMEMORY_TOKEN_HASHES=<sha256-hex-from-mem-token-create>
# AGENTMEMORY_TOKEN_PEPPER=

# OAuth for browser/native MCP clients (optional; Cursor Bearer unchanged)
# AGENTMEMORY_OAUTH_ENABLED=true
# AGENTMEMORY_OAUTH_PASSWORD_HASH=<sha256-hex-from-mem-oauth-password-hash>
# AGENTMEMORY_GOOGLE_CLIENT_ID=
# AGENTMEMORY_GOOGLE_CLIENT_SECRET=
# AGENTMEMORY_OAUTH_CLIENT_ID=agentmemory
# AGENTMEMORY_PUBLIC_BASE_URL=https://mem.agentmemory.md
# HTTPS allowlist plus RFC 8252 http://127.0.0.1|localhost|::1:<port>/... loopback
# AGENTMEMORY_OAUTH_REDIRECT_ALLOWLIST=https://grok.com/connectors-oauth-exchange-code/
# AGENTMEMORY_OAUTH_ALLOWED_EMAIL=tonyzorin@gmail.com

# Log level
LOG_LEVEL=INFO

# Tag → Project entity UUID map for `memory wire-orphans` (deployment-specific)
# PROJECT_ANCHORS_JSON={"my-app":"00000000-0000-0000-0000-000000000001"}
